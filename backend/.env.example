# =========================================================
# SMART CAMPUS DIGITAL TWIN — BACKEND
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Placeholders only. Never commit a real service-role key.
# =========================================================

# --- Database ------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telemetry engine (Phase 5) ------------------------------
#
# The broker is `docker compose up -d` from the repo root.
# MQTT_ENABLED stays false until a worker is wired up.

MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smart-campus

# Reading interval per sensor, and buffer flush interval.
TELEMETRY_TICK_SECONDS=5
TELEMETRY_FLUSH_SECONDS=10

# --- Intelligence engine (Phase 6) ---------------------------
#
# Rules run over telemetry after it is persisted. They are
# deterministic: no model, no API key, no network. Turn this
# off to ingest telemetry without producing incidents.

INTELLIGENCE_ENABLED=true
DEFAULT_CAMPUS_CODE=CIT-MAIN

# --- Vision engine (Phase 7) ----------------------------------
#
# Counts people in an uploaded still image. This is image
# analysis, not a live camera feed: nothing here opens a
# stream or polls a camera.
#
# Model weights are never downloaded automatically. Place
# yolo11n.pt in backend/vision/weights/ (which is gitignored),
# or point VISION_MODEL_PATH at an existing file. Until then
# GET /api/v1/vision/status reports detector_available false
# and POST /api/v1/vision/analyze returns 503.
#
# Weights are Ultralytics assets under AGPL-3.0.

VISION_ENABLED=true

# Detections below this confidence are discarded.
VISION_CONFIDENCE_THRESHOLD=0.45

# Non-maximum suppression overlap for merging duplicate boxes.
VISION_IOU_THRESHOLD=0.50

# Uploads larger than this are rejected. 10 MiB.
VISION_MAX_UPLOAD_BYTES=10485760

# Absolute path to the weights file. Leave empty to use
# backend/vision/weights/yolo11n.pt.
VISION_MODEL_PATH=
