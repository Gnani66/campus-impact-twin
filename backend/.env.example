# Smart Campus Digital Twin API — Environment Variables

# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS — comma-separated list of allowed origins
# Add your Vercel frontend URL here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Feature flags
MQTT_ENABLED=false
INTELLIGENCE_ENABLED=true
VISION_ENABLED=false

# Telemetry
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=smart-campus
TELEMETRY_TICK_SECONDS=5
TELEMETRY_FLUSH_SECONDS=10

# Default campus
DEFAULT_CAMPUS_CODE=CIT-MAIN

# Vision (only needed if VISION_ENABLED=true)
VISION_CONFIDENCE_THRESHOLD=0.45
VISION_IOU_THRESHOLD=0.50
VISION_MAX_UPLOAD_BYTES=10485760
VISION_MODEL_PATH=
