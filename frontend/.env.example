# SMART CAMPUS DIGITAL TWIN — FRONTEND

# Must match the port the backend is started on. The README
# starts it on 8000.
#
# 127.0.0.1 rather than localhost: uvicorn binds 127.0.0.1 by
# default, and where localhost resolves to ::1 first, the
# request is refused by a backend that is running fine.
#
# NEXT_PUBLIC_* values are inlined at build time, so restart
# `npm run dev` after changing this.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
