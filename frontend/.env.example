# Frontend Environment Variables

# The backend API URL. Must include the scheme and no trailing
# slash — lib/api.ts appends "/api/v1/..." to this value.
#
# Deployed (Render):
NEXT_PUBLIC_API_URL=https://campus-impact-twin-api.onrender.com

# For local backend work, replace the line above with:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# The name of this variable must match lib/api.ts. It is
# NEXT_PUBLIC_API_URL, not NEXT_PUBLIC_BACKEND_URL — renaming it
# silently falls back to the hardcoded default in that file
# rather than erroring.

# Where the lecture hall GLB is loaded from. Optional: it defaults
# to /models/lecture-hall.glb.
#
# Set this in production. The file is 260 MB and public/models is
# gitignored, so a build from the repository has no model to serve
# and the twin falls back to a wireframe placeholder.
#
# Must serve CORS headers, and must be reachable from a browser.
# A public bucket URL works:
#
# NEXT_PUBLIC_MODEL_URL=https://<project>.supabase.co/storage/v1/object/public/<bucket>/lecture-hall.glb
#
# Leave blank or unset to use the local path.
